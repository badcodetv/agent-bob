# The chat-ui package's build output and the tarball `npm pack` leaves beside
# it. Both are generated (web/scripts/verify-package.sh, deploy/web.Dockerfile),
# and the tarball is copied into agent-wolf/web/vendor/ by hand rather than
# committed here.
web/dist/
web/*.tgz

# Local env + secrets — never commit
.env
node_modules
secrets/
*.key.json
gcp-key.json

docker-compose.override.yml
oranged-data/
e2e/stack-e2e-logs*.txt
e2e/.stack-e2e-mode

# ./stack: which image mode the running stack was started in
.stack-image-mode

# ./stack wolf: local dev secrets for the Agent Wolf workflow (never commit)
.stack-wolf-secrets.env
