# The chat-ui package's build output and the tarball `npm pack` leaves beside
# it. Both are generated (web/scripts/verify-package.sh, deploy/web.Dockerfile),
# and the tarball is copied into agent-wolf/web/vendor/ by hand rather than
# committed here.
web/dist/
web/*.tgz

# The guide (ticket C1): examples/web/scripts/build-guide.mjs writes this
# from docs/guide/*.md on every build. Never hand-edit.
web/src/guide/firstParagraphs.generated.json

# Local env + secrets — never commit
.env
node_modules
secrets/
*.key.json
gcp-key.json

docker-compose.override.yml
e2e/stack-e2e-logs*.txt
e2e/.stack-e2e-mode

# ./stack: which image mode the running stack was started in
.stack-image-mode

# ./stack wolf: local dev secrets for the Agent Wolf workflow (never commit)
.stack-wolf-secrets.env

# Project connections (design/2026-09-11-project-connections.md): the operator's
# project map and connection tokens, mounted into agentd at /etc/agent-bob/.
# Only the README and the worked example are tracked.
local-config/*
!local-config/README.md
!local-config/project-map.example.json
