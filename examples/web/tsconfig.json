{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["vite/client"],
    // Typecheck against the EMITTED declarations, not against web/src — the
    // same package surface the Vite alias resolves at build time (O12).
    // `npm run build` in web/ must have run first.
    "paths": {
      "@agentkit/chat-ui": ["../../web/dist/index.d.ts"],
      "@agentkit/chat-ui/pure": ["../../web/dist/pure.d.ts"],
      "@agentkit/chat-ui/components": ["../../web/dist/components/index.d.ts"]
    }
  },
  "include": ["src"]
}
